{
  "manifest_version": 3,
  "name": "Backlog Quick Add",
  "version": "1.1.0",
  "description": "選択テキストやページ情報からBacklogへ課題を作成。サイドパネルで入力し、任意でOpenAIまたはGeminiでフィールドを自動補完できます。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "alarms",
    "clipboardRead",
    "clipboardWrite",
    "contextMenus",
    "scripting",
    "sidePanel",
    "storage",
    "windows"
  ],
  "host_permissions": [
    "https://*.backlog.com/*",
    "https://*.backlog.jp/*",
    "https://*.backlogtool.com/*",
    "https://api.openai.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.github.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "images/icon16.png",
    "32": "images/icon32.png",
    "48": "images/icon48.png",
    "128": "images/icon128.png"
  },
  "action": {
    "default_title": "Backlog Quick Add",
    "default_icon": {
      "16": "images/icon16.png",
      "32": "images/icon32.png",
      "48": "images/icon48.png",
      "128": "images/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "commands": {
    "open-task-form": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Backlogにタスク作成（選択テキストを詳細に貼り付け）"
    }
  }
}
